SITE_URL=http://127.0.0.1:3000
# Optional fallback for running Next.js and uvicorn separately, not for Vercel.
CONTENT_API_URL=http://127.0.0.1:8000
# CONTENT_SERVICE_URL is injected by Vercel's binding. Never set it manually.

# Chat stays off until Gateway settings and deployment-level rate/billing controls are ready.
CHAT_AGENT_ENABLED=false
# Set server-side only in the hosting environment; never prefix these with NEXT_PUBLIC_.
# AI_GATEWAY_API_KEY=
# AI_MODEL_FAST=
